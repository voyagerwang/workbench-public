# Supabase 双设备同步（不要把 service_role 密钥提交到 Git）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_SYNC_WORKSPACE_ID=
SUPABASE_SYNC_DEVICE_NAME=我的电脑
SUPABASE_SYNC_INTERVAL_MS=10000

# 两台电脑只让一台负责系统提醒和外部日历/知识库后台刷新，避免重复推送。
# primary=运行后台任务；secondary=只同步数据。
WORKBENCH_DEVICE_ROLE=primary

# 默认仅本机访问；需要局域网访问时显式设置 HOST=0.0.0.0，并配置 ACCESS_TOKEN。
HOST=127.0.0.1
ACCESS_TOKEN=

# 外部适配器默认关闭，按需显式启用。
ENABLE_EXTERNAL_CONNECTORS=0
ENABLE_SUPABASE_SYNC=0

# PPT/PPTX 预览使用本地 LibreOffice。可选：指定 soffice 可执行文件完整路径。
# 默认依次检查标准安装位置、本机 Codex 附带的 LibreOffice 与 PATH。
OFFICE_CONVERTER=

# 额外可信网页来源，逗号分隔；仅远程访问时按需指定。
WORKBENCH_ALLOWED_ORIGINS=
